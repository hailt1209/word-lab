function runnerGame(count){
  let W=800; const H=450, GROUND=400, G=0.0022, JUMP=0.86, SPEED=0.3, L=2500;
  const BFONT="700 16px 'Baloo 2', system-ui, sans-serif";
  const qs=shuffle(WORDS).slice(0,count), N=qs.length, TOTAL_MS=RUNNER.TIME_PER_WORD*1000;
  let qi=0, lives=RUNNER.LIVES, score=0, correct=0, missed=[], tleft=TOTAL_MS;
  let phase="play", clock=0, freezeUntil=0, afterFreeze=null, msg=null, parts=[];
  let world=null, hero=null, camX=0, paused=false, alive=true, gone=false, raf=0, last=0, jumpBuf=0;
  const keys={left:false,right:false,jump:false};

  $app.innerHTML=`
    <div class="phud">
      <div class="pstats"><span class="hearts" id="rh"></span><span id="rq"></span><span id="rs"></span><button id="rp">⏸</button></div>
      <div class="desc"><button class="say" id="rsay" title="Read the meaning aloud">🔊</button><small>Find the word that means:</small><div id="rd"></div></div>
      <div class="tbar"><i id="rt"></i></div>
    </div>
    <div class="stage"><canvas id="cv"></canvas><div class="pauseveil" id="rveil">PAUSED<br><small>tap to continue</small></div></div>
    <div class="pad run"><button id="bl" aria-label="Run left">◀</button><button id="br" aria-label="Run right">▶</button><button id="bj" class="jumpbtn">JUMP</button></div>
    <div class="keys-hint">Keyboard: ← → to run · ↑ or Space to jump · P to pause</div>`;
  const cv=document.getElementById("cv"), ctx=cv.getContext("2d"), veil=document.getElementById("rveil");
  function fit(){ W = $app.clientWidth<600 ? 540 : 800; cv.style.aspectRatio=`${W}/${H}`; const r=cv.getBoundingClientRect(), dpr=window.devicePixelRatio||1; cv.width=Math.max(1,Math.round(r.width*dpr)); cv.height=Math.round(r.width*H/W*dpr); ctx.setTransform(cv.width/W,0,0,cv.width/W,0,0); }

  const overlap=(a,b)=>a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y;
  function wrapLabel(t){
    ctx.font=BFONT; if(ctx.measureText(t).width<=210) return [t];
    const ws=t.split(" "); let best=[t], bw=1e9;
    for(let i=1;i<ws.length;i++){ const a=ws.slice(0,i).join(" "), b=ws.slice(i).join(" "); const m=Math.max(ctx.measureText(a).width,ctx.measureText(b).width); if(m<bw){bw=m;best=[a,b];} }
    return best;
  }
  function build(){
    const q=qs[qi];
    const pool=WORDS.filter(x=>x.id!==q.id && !(x.k && x.k===q.k));
    const same=shuffle(pool.filter(x=>x.c===q.c)).slice(0,2);
    const other=shuffle(pool.filter(x=>!same.includes(x))).slice(0,3-same.length);
    const opts=shuffle([q,...same,...other]);
    const solids=[], blocks=[], enemies=[], coins=[];
    const gaps=[[760,840],[1880,1960]];
    let gx=0; for(const [a,b] of gaps){ solids.push({x:gx,y:GROUND,w:a-gx,h:120,t:"ground"}); gx=b; }
    solids.push({x:gx,y:GROUND,w:L-gx,h:120,t:"ground"});
    solids.push({x:1335,y:GROUND-64,w:52,h:64,t:"pillar"});
    const slotX=[520,1080,1640,2200];
    opts.forEach((o,i)=>{
      const lines=wrapLabel(o.w); ctx.font=BFONT;
      const w=Math.max(96,Math.max(...lines.map(s=>ctx.measureText(s).width))+30), h=lines.length>1?56:38;
      const high=Math.random()<0.5, bottom=high?182:292;
      if(high) solids.push({x:slotX[i]-130,y:300,w:260,h:22,t:"brick"});
      const b={x:slotX[i]-w/2,y:bottom-h,w,h,t:"block",o,lines,state:"new",bump:0};
      blocks.push(b); solids.push(b);
    });
    const zones=[[380,740],[860,1310],[1410,1860],[1980,2450]];
    shuffle(zones).slice(0,3).forEach(([a,b])=>{
      const x=a+40+Math.random()*(b-a-110);
      enemies.push({x,y:GROUND-28,w:32,h:28,vx:(Math.random()<.5?-1:1)*(0.04+Math.random()*0.03),min:a,max:b,alive:true,sq:0});
    });
    zones.forEach(([a,b])=>{ for(let i=0;i<2;i++) coins.push({x:a+30+Math.random()*(b-a-60),y:GROUND-60-Math.random()*60,got:false}); });
    world={solids,blocks,enemies,coins};
    hero={x:80,y:GROUND-38,w:30,h:38,vx:0,vy:0,on:true,face:1,inv:0,safeX:80};
    camX=0; tleft=TOTAL_MS; msg=null; parts=[];
    hud();
  }
  function hud(){
    document.getElementById("rh").textContent="❤️".repeat(Math.max(0,lives))+"🖤".repeat(RUNNER.LIVES-Math.max(0,lives));
    document.getElementById("rq").textContent=`Word ${Math.min(qi+1,N)}/${N}`;
    document.getElementById("rs").textContent=`⭐ ${score}`;
    document.getElementById("rd").textContent=qs[Math.min(qi,N-1)].d;
  }
  function hudTimer(){ const el=document.getElementById("rt"); if(!el) return; el.style.width=Math.max(0,tleft/TOTAL_MS*100)+"%"; el.classList.toggle("low",tleft<10000); }
  function show(text,ms=1500){ msg={text,until:clock+ms}; }
  function pop(x,y,text){ parts.push({x,y,text,t:900}); }
  function freeze(ms,fn){ if(phase!=="over") phase="freeze"; freezeUntil=clock+ms; afterFreeze=fn; }
  function hurt(text){
    lives--; hud(); show(text,1800); tone([200,150,110],"sawtooth",0.08,0.1,0.15);
    if(lives<=0){ phase="over"; freezeUntil=clock+1800; afterFreeze=()=>end(false); }
  }
  function hit(b){
    b.bump=1;
    if(phase!=="play" || b.state!=="new"){ tone([300],"square",0.04,0,0.05); return; }
    const q=qs[qi];
    if(b.o.id===q.id){
      b.state="right"; correct++; const pts=100+Math.ceil(tleft/1000)*5; score+=pts; hud();
      pop(b.x+b.w/2,b.y-8,`+${pts}`); tone([988,1319,1568],"square",0.07,0.08,0.12); say(b.o.w);
      show(`✅ ${b.o.w}!`,1600); freeze(1700,next);
    }else{
      b.state="wrong"; if(!missed.includes(q)) missed.push(q);
      hurt(`❌ Not “${b.o.w}” – keep looking!`);
    }
  }
  function timeout(){
    const q=qs[qi]; if(!missed.includes(q)) missed.push(q);
    world.blocks.forEach(b=>{ if(b.o.id===q.id) b.state="reveal"; });
    tleft=0; hurt(`⏰ Time's up! It was “${q.w}”`);
    if(phase!=="over"){ freeze(2400,next); const rb=world.blocks.find(b=>b.state==="reveal"); if(rb) camX=Math.max(0,Math.min(L-W,rb.x+rb.w/2-W/2)); }
  }
  function next(){ qi++; if(qi>=N) return end(true); build(); phase="play"; }

  function step(dt){
    const h=hero, ctl=phase==="play";
    h.stun=Math.max(0,(h.stun||0)-dt);
    const dir=(ctl&&!h.stun)?(keys.right?1:0)-(keys.left?1:0):0;
    h.vx=dir*SPEED; if(dir) h.face=dir;
    jumpBuf=Math.max(0,jumpBuf-dt);
    if(ctl && jumpBuf>0 && h.on){ h.vy=-JUMP; h.on=false; jumpBuf=0; tone([523,784],"square",0.05,0.05,0.08); }
    if(!keys.jump && h.vy<-0.35) h.vy=-0.35;
    h.vy=Math.min(1.1,h.vy+G*dt);
    h.x+=h.vx*dt; h.x=Math.max(0,Math.min(L-h.w,h.x));
    for(const s of world.solids) if(overlap(h,s)){ if(h.vx>0) h.x=s.x-h.w; else if(h.vx<0) h.x=s.x+s.w; }
    h.y+=h.vy*dt; h.on=false;
    for(const s of world.solids) if(overlap(h,s)){
      if(h.vy>0){ h.y=s.y-h.h; h.vy=0; h.on=true; if(s.t==="ground") h.safeX=Math.min(Math.max(h.x,s.x+20),s.x+s.w-h.w-120); }
      else if(h.vy<0){ h.y=s.y+s.h; h.vy=0; if(s.t==="block") hit(s); }
    }
    h.inv=Math.max(0,h.inv-dt);
    if(h.y>H+40){
      if(phase==="play") hurt("🕳️ Oops! You fell in a hole");
      h.x=h.safeX; h.y=GROUND-h.h-80; h.vy=0; h.inv=1500; h.stun=700;
    }
    for(const e of world.enemies){
      if(!e.alive){ e.sq-=dt; continue; }
      e.x+=e.vx*dt; if(e.x<e.min){e.x=e.min;e.vx*=-1;} if(e.x+e.w>e.max){e.x=e.max-e.w;e.vx*=-1;}
      if(phase==="play" && overlap(h,e)){
        if(h.vy>0 && h.y+h.h-e.y<18){ e.alive=false; e.sq=450; h.vy=-0.6; score+=50; hud(); pop(e.x+e.w/2,e.y,"+50"); tone([392,262],"square",0.06,0.06,0.1); }
        else if(h.inv<=0){ h.inv=1600; h.vy=-0.5; h.x+=h.x<e.x?-40:40; h.x=Math.max(0,h.x); hurt("🐌 Ouch! A snail!"); }
      }
    }
    world.enemies=world.enemies.filter(e=>e.alive||e.sq>0);
    for(const c of world.coins) if(!c.got && overlap(h,{x:c.x-10,y:c.y-10,w:20,h:20})){ c.got=true; score+=10; hud(); tone([1319,1760],"square",0.05,0.05,0.08); }
    for(const b of world.blocks) b.bump=Math.max(0,b.bump-dt/220);
    for(const p of parts){ p.t-=dt; p.y-=dt*0.05; } parts=parts.filter(p=>p.t>0);
    if(phase==="play"){ tleft-=dt; if(tleft<=0) timeout(); }
    if(phase==="play") camX=Math.max(0,Math.min(L-W,h.x+h.w/2-W*0.42));
  }

  function rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
  function cloud(x,y){ ctx.beginPath(); ctx.arc(x,y,22,0,7); ctx.arc(x+26,y-10,28,0,7); ctx.arc(x+56,y,22,0,7); ctx.fill(); }
  function drawSolid(s){
    if(s.t==="ground"){
      ctx.fillStyle="#c9773a"; ctx.fillRect(s.x,s.y,s.w,s.h);
      ctx.fillStyle="#a85e2a"; for(let x=s.x+14;x<s.x+s.w-6;x+=34){ ctx.fillRect(x,s.y+24+((x*7)%14),6,6); }
      ctx.fillStyle="#4cbb47"; ctx.fillRect(s.x,s.y,s.w,12); ctx.fillStyle="#3a9a37"; ctx.fillRect(s.x,s.y+10,s.w,3);
    }else if(s.t==="brick"){
      ctx.fillStyle="#d9653b"; ctx.fillRect(s.x,s.y,s.w,s.h);
      ctx.strokeStyle="#9e3f22"; ctx.lineWidth=2; ctx.strokeRect(s.x+1,s.y+1,s.w-2,s.h-2);
      ctx.beginPath(); for(let x=s.x+26;x<s.x+s.w;x+=26){ ctx.moveTo(x,s.y); ctx.lineTo(x,s.y+s.h); } ctx.stroke();
    }else if(s.t==="pillar"){
      ctx.fillStyle="#8d8d9b"; ctx.fillRect(s.x,s.y,s.w,s.h); ctx.fillStyle="#a9a9b8"; ctx.fillRect(s.x-5,s.y,s.w+10,12);
      ctx.fillStyle="#76768a"; ctx.fillRect(s.x+8,s.y+16,6,s.h-20);
    }
  }
  function drawBlock(b){
    const off=Math.sin(b.bump*Math.PI)*8, y=b.y-off;
    let fill="#ffcc33", line="#a86b00";
    if(b.state==="right"){ fill="#3ad17a"; line="#16824a"; }
    else if(b.state==="wrong"){ fill="#c4bfd2"; line="#7d7891"; }
    else if(b.state==="reveal"){ const on=Math.floor(clock/250)%2; fill=on?"#3ad17a":"#ffffff"; line="#16824a"; }
    ctx.fillStyle="#0002"; rr(b.x+3,y+4,b.w,b.h,8); ctx.fill();
    ctx.fillStyle=fill; rr(b.x,y,b.w,b.h,8); ctx.fill(); ctx.lineWidth=3; ctx.strokeStyle=line; ctx.stroke();
    ctx.fillStyle=line; [[6,6],[b.w-6,6],[6,b.h-6],[b.w-6,b.h-6]].forEach(([dx,dy])=>{ ctx.beginPath(); ctx.arc(b.x+dx,y+dy,2,0,7); ctx.fill(); });
    ctx.fillStyle=b.state==="wrong"?"#6f6890":"#2b2350"; ctx.font=BFONT; ctx.textAlign="center"; ctx.textBaseline="middle";
    b.lines.forEach((s,i)=>ctx.fillText(s,b.x+b.w/2,y+b.h/2+(i-(b.lines.length-1)/2)*18+1));
    if(b.state==="wrong"){ ctx.strokeStyle="#e5484d"; ctx.lineWidth=3; ctx.beginPath(); ctx.moveTo(b.x+8,y+8); ctx.lineTo(b.x+b.w-8,y+b.h-8); ctx.stroke(); }
  }
  function draw(){
    const g=ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,"#5ec8ff"); g.addColorStop(1,"#c8eeff"); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    ctx.fillStyle="#ffffffdd"; for(let i=0;i<7;i++){ const span=W+300, x=((i*330-camX*0.3)%span+span)%span-150; cloud(x,40+(i*47)%100); }
    ctx.fillStyle="#8fdc8f"; for(let i=0;i<9;i++){ const x=i*400-camX*0.5; ctx.beginPath(); ctx.ellipse(x,GROUND+4,170,80+(i%3)*30,0,Math.PI,0); ctx.fill(); }
    ctx.save(); ctx.translate(-Math.round(camX),0);
    for(const s of world.solids) if(s.t!=="block") drawSolid(s);
    for(const c of world.coins){ if(c.got) continue; const by=Math.sin(clock/250+c.x)*3; ctx.fillStyle="#ffd23f"; ctx.beginPath(); ctx.ellipse(c.x,c.y+by,8,10,0,0,7); ctx.fill(); ctx.strokeStyle="#c79400"; ctx.lineWidth=2; ctx.stroke(); ctx.fillStyle="#fff7"; ctx.fillRect(c.x-2,c.y+by-6,3,8); }
    for(const b of world.blocks) drawBlock(b);
    ctx.textAlign="center"; ctx.textBaseline="bottom";
    for(const e of world.enemies){
      ctx.save(); ctx.translate(e.x+e.w/2,e.y+e.h); if(e.vx>0) ctx.scale(-1,1); if(!e.alive) ctx.scale(1.2,0.35);
      ctx.fillStyle="#000"; ctx.font="30px serif"; ctx.fillText("🐌",0,3); ctx.restore();
    }
    const h=hero;
    if(!(h.inv>0 && Math.floor(clock/90)%2)){
      ctx.fillStyle="#0003"; ctx.beginPath(); ctx.ellipse(h.x+h.w/2,(h.on?h.y+h.h:GROUND)+1,14,4,0,0,7); ctx.fill();
      ctx.save(); ctx.translate(h.x+h.w/2,h.y+h.h); if(h.face<0) ctx.scale(-1,1);
      const bob=h.on&&h.vx?Math.abs(Math.sin(clock/70))*-4:0, tilt=h.on?(h.vx?0.08:0):-0.12;
      ctx.rotate(tilt); ctx.fillStyle="#000"; ctx.font="40px serif"; ctx.fillText("🦉",0,4+bob); ctx.restore();
    }
    ctx.font="800 20px 'Baloo 2', sans-serif";
    for(const p of parts){ ctx.globalAlpha=Math.min(1,p.t/400); ctx.fillStyle="#fff"; ctx.strokeStyle="#2b2350"; ctx.lineWidth=4; ctx.strokeText(p.text,p.x,p.y); ctx.fillText(p.text,p.x,p.y); }
    ctx.globalAlpha=1; ctx.restore();
    if(msg && clock<msg.until){
      ctx.font="800 22px 'Baloo 2', sans-serif"; ctx.textAlign="center"; ctx.textBaseline="middle";
      const tw=Math.min(W-40,ctx.measureText(msg.text).width+36);
      ctx.fillStyle="#000b"; rr(W/2-tw/2,18,tw,44,14); ctx.fill(); ctx.fillStyle="#fff"; ctx.fillText(msg.text,W/2,41,W-60);
    }
  }
  function loop(t){
    if(!alive) return;
    raf=requestAnimationFrame(loop);
    let dt=Math.min(50,t-(last||t)); last=t;
    if(!paused){
      clock+=dt;
      while(dt>0 && alive){ const d=Math.min(16,dt); step(d); dt-=d; }
      if(alive && phase!=="play" && afterFreeze && clock>=freezeUntil){ const f=afterFreeze; afterFreeze=null; f(); }
    }
    if(alive){ draw(); hudTimer(); }
  }
  function setPause(p){ if(!alive) return; paused=p; veil.classList.toggle("on",p); document.getElementById("rp").textContent=p?"▶":"⏸"; keys.left=keys.right=keys.jump=false; }
  const KEYMAP={arrowleft:"left",a:"left",arrowright:"right",d:"right",arrowup:"jump",w:"jump"," ":"jump"};
  function onDown(e){
    const k=e.key.toLowerCase();
    if(k==="p"||k==="escape"){ setPause(!paused); return; }
    const m=KEYMAP[k]; if(!m) return; e.preventDefault();
    if(m==="jump" && !keys.jump) jumpBuf=130;
    keys[m]=true;
  }
  function onUp(e){ const m=KEYMAP[e.key.toLowerCase()]; if(!m) return; e.preventDefault(); keys[m]=false; }
  function onVis(){ if(document.hidden) setPause(true); }
  function stop(){ gone=true; alive=false; cancelAnimationFrame(raf); document.removeEventListener("keydown",onDown); document.removeEventListener("keyup",onUp); document.removeEventListener("visibilitychange",onVis); window.removeEventListener("resize",fit); }
  function end(win){
    if(gone) return; stop(); stopCurrent=null;
    result(6,{pct:correct/N, missed, title: win?"You finished the course! 🏁":"Game over! 🦉",
      detail:`${correct} of ${N} words found · ${score} points`});
  }
  function hold(id,m){
    const b=document.getElementById(id);
    const on=e=>{ e.preventDefault(); if(m==="jump" && !keys.jump) jumpBuf=130; keys[m]=true; try{ b.setPointerCapture(e.pointerId); }catch(_){} };
    const off=()=>{ keys[m]=false; };
    b.addEventListener("pointerdown",on); ["pointerup","pointercancel","lostpointercapture"].forEach(ev=>b.addEventListener(ev,off));
    b.addEventListener("contextmenu",e=>e.preventDefault());
  }
  hold("bl","left"); hold("br","right"); hold("bj","jump");
  document.getElementById("rp").onclick=()=>setPause(!paused);
  document.getElementById("rsay").onclick=()=>say(qs[qi].d);
  veil.onclick=()=>setPause(false);
  document.addEventListener("keydown",onDown); document.addEventListener("keyup",onUp);
  document.addEventListener("visibilitychange",onVis); window.addEventListener("resize",fit);
  stopCurrent=stop;
  fit(); build(); hudTimer();
  cv.scrollIntoView({block:"center",behavior:"smooth"});
  raf=requestAnimationFrame(loop);
}

/* ===== Result ===== */
function result(level,{pct,stars,missed=[],detail,title,mistakeRate}){
  leave();
  if(stars===undefined) stars = pct>=0.9?3 : pct>=0.7?2 : pct>=0.4?1 : 0;
  saveBest(level,stars);
  let gate="";
  if(mistakeRate!==undefined){
    const wasOpen=bossUnlocked(); saveProg(level,mistakeRate); const nowOpen=bossUnlocked();
    const ok=mistakeRate<=UNLOCK.MAX_MISTAKE_RATE+1e-9, limit=pctStr(UNLOCK.MAX_MISTAKE_RATE);
    gate = !wasOpen && nowOpen
      ? `<div class="review" style="text-align:center;background:linear-gradient(120deg,#2a1b5e,#47208a);color:#fff"><h3 style="font-size:22px">🐉 Boss Battle unlocked!</h3>You passed Levels 1–4. The Word Dragon is waiting…</div>`
      : `<div class="review" style="text-align:center;border:3px solid ${ok?"var(--good)":"var(--bad)"}"><b>Mistakes: ${pctStr(mistakeRate)}</b> – ${ok?`✅ passed (${limit} or fewer)`:`need ${limit} or fewer to count toward the Boss Battle. Try again!`}</div>`;
  }
  const nextBtn = level===4 ? (bossUnlocked()?`<button class="btn" id="nextL">🐉 Boss Battle ➡️</button>`:`<button class="btn" id="toMenu">🏠 Menu</button>`)
                : level!==4 && level<6 ? `<button class="btn" id="nextL">Level ${level+1} ➡️</button>` : `<button class="btn" id="toMenu">🏠 Menu</button>`;
  const msg = stars===3?"Amazing! You're a word champion! 🏆" : stars===2?"Great work! Almost perfect! 👏" : stars===1?"Good try! Practise a bit more. 💪" : "Keep going – you'll get there! 🌱";
  const seen=new Set(); missed=missed.filter(o=>!seen.has(o.id)&&seen.add(o.id));
  $app.innerHTML=`
    <div class="result">
      <h1>${esc(title||`Level ${level} complete!`)}</h1>
      <div class="bigstars">${starStr(stars)}</div>
      <p class="score">${esc(detail)}</p>
      <p style="font-size:20px;font-weight:700;margin:6px 0 0">${msg}</p>
    </div>
    ${gate}
    ${missed.length?`<div class="review"><h3>📌 Words to practise (tap to hear)</h3><div class="chips">${missed.map(o=>`<button class="chip" data-id="${o.id}" title="${esc(o.d)}">${o.p?o.p+" ":""}${esc(o.w)}</button>`).join("")}</div></div>`:""}
    <div class="row" style="margin-top:14px">
      <button class="btn ghost" id="again">🔁 Play again</button>
      ${nextBtn}
    </div>`;
  $app.querySelectorAll(".chip").forEach(b=>b.onclick=()=>say(WORDS[+b.dataset.id].w));
  document.getElementById("again").onclick=()=>startLevel(level);
  const n=document.getElementById("nextL"); if(n) n.onclick=()=>startLevel(level+1);
  const m=document.getElementById("toMenu"); if(m) m.onclick=menu;
  if(stars>=2) confetti();
  window.scrollTo(0,0);
}

menu();
</script>
