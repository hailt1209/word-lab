function bossGame(){
  const total=WORDS.length, maxMiss=Math.max(1,Math.round(total*BOSS.MISS_RATE));
  let gone=false, queue=shuffle(WORDS), hp=total, misses=0, missed=[], cur=null, paused=false, alive=true, raf=0, last=0, waitUntil=0, heroLane=2;
  $app.innerHTML=`
    <div class="hud">
      <span class="hearts" id="hearts"></span>
      <span id="left"></span>
      <button id="pauseBtn">⏸ PAUSE</button>
    </div>
    <div class="arena" id="arena">
      <div class="boss"><div class="face" id="bossFace">🐉</div><div class="hpbar"><i id="hp" style="width:100%"></i></div><div class="bossname">WORD DRAGON</div></div>
      <div class="fword" id="fw" hidden></div>
      <div class="heroman" id="hero">🧙</div>
      <div class="toast" id="toast"></div>
      <div class="buckets">${CAT_KEYS.map((k,i)=>`<button class="bucket" data-lane="${i}" style="--cc:${CATS[k].color}"><span class="bi">${CATS[k].icon}</span>${CATS[k].short}</button>`).join("")}</div>
      <div class="pauseveil" id="veil">PAUSED<br><small>tap to continue</small></div>
    </div>
    <div class="pad"><button id="lb" aria-label="Move left">◀</button><button id="db" aria-label="Drop">▼</button><button id="rb" aria-label="Move right">▶</button></div>
    <div class="keys-hint">Keyboard: ← → to move · ↓ or Space to drop · P to pause</div>`;
  const arena=document.getElementById("arena"), fw=document.getElementById("fw"), hero=document.getElementById("hero"),
        face=document.getElementById("bossFace"), toastEl=document.getElementById("toast"), veil=document.getElementById("veil"),
        buckets=[...arena.querySelectorAll(".bucket")];

  function hud(){
    const left=maxMiss-misses;
    document.getElementById("hearts").textContent = maxMiss<=10 ? "❤️".repeat(left)+"🖤".repeat(misses) : `❤️×${left}`;
    document.getElementById("left").textContent=`HP ${hp}/${total}`;
    document.getElementById("hp").style.width=(hp/total*100)+"%";
  }
  const laneX = lane => (lane+0.5)*arena.clientWidth/5;
  function place(){
    const W=arena.clientWidth, H=arena.clientHeight, bucketTop=H-82, heroH=hero.offsetHeight||46;
    heroLane += ((cur?cur.target:heroLane)-heroLane)*0.25;
    hero.style.transform=`translate(${laneX(heroLane)-hero.offsetWidth/2}px,${bucketTop-heroH-2}px)`;
    if(!cur) return;
    const cw=fw.offsetWidth, ch=fw.offsetHeight, startY=H*0.22, endY=bucketTop-heroH-ch-4;
    const x=Math.min(W-cw-6,Math.max(6,laneX(cur.lane)-cw/2));
    fw.style.transform=`translate(${x}px,${startY+(endY-startY)*Math.min(1,cur.y)}px)`;
  }
  function spawn(){
    const o=queue.shift();
    cur={o, lane:2, target:2, y:0, fast:false};
    fw.innerHTML=`${o.p?`<span class="e">${o.p}</span>`:""}${esc(o.w)}`; fw.hidden=false; place();
  }
  function move(d){ if(!cur||paused) return; cur.target=Math.max(0,Math.min(4,cur.target+d)); tone([440],"square",0.04,0,0.05); }
  function drop(){ if(!cur||paused) return; cur.fast=true; }
  function throwTo(lane){ if(!cur||paused) return; cur.target=lane; cur.fast=true; }
  function toast(msg){ toastEl.textContent=msg; toastEl.classList.add("show"); setTimeout(()=>toastEl.classList.remove("show"),1500); }
  function bolt(){
    const b=document.createElement("div"); b.className="bolt"; b.textContent="⚡"; arena.appendChild(b);
    const hr=hero.getBoundingClientRect(), fr=face.getBoundingClientRect(), ar=arena.getBoundingClientRect();
    const x0=hr.left-ar.left+hr.width/2-15, y0=hr.top-ar.top, x1=fr.left-ar.left+fr.width/2-15, y1=fr.top-ar.top+fr.height/2-15;
    try{ b.animate([{transform:`translate(${x0}px,${y0}px) scale(.6)`},{transform:`translate(${x1}px,${y1}px) scale(1.4)`}],{duration:320,easing:"ease-in"}).onfinish=()=>b.remove(); }
    catch(e){ b.remove(); }
  }
  function land(){
    const lane=Math.round(cur.target), o=cur.o, ok=CAT_KEYS[lane]===o.c;
    cur=null; fw.hidden=true;
    if(ok){
      hp--; anim(buckets[lane],"good"); bolt(); tone([880,1320],"square",0.07,0.06,0.1);
      setTimeout(()=>{ anim(face,"hit"); tone([140,90],"sawtooth",0.07,0.05,0.12); hud(); },300);
      if(hp===0){ setTimeout(()=>{ face.classList.add("dead"); tone([523,659,784,1046,1318],"square",0.08,0.12,0.18); },350); return end(true); }
    }else{
      misses++; missed.push(o); anim(buckets[lane],"bad"); anim(hero,"hurt");
      const right=CAT_KEYS.indexOf(o.c); buckets[right].classList.add("hint"); setTimeout(()=>buckets[right].classList.remove("hint"),1500);
      toast(`“${o.w}” → ${CATS[o.c].icon} ${CATS[o.c].short}`); tone([200,150,110],"sawtooth",0.08,0.1,0.15); hud();
      queue.splice(Math.min(queue.length,3+Math.floor(Math.random()*5)),0,o);
      if(misses>=maxMiss){ hero.classList.add("dead"); hero.textContent="👻"; return end(false); }
    }
    waitUntil=performance.now()+ (ok?650:1500);
  }
  function loop(t){
    if(!alive) return;
    raf=requestAnimationFrame(loop);
    const dt=Math.min(50,t-(last||t)); last=t;
    if(paused) return;
    if(!cur){ if(t>=waitUntil && queue.length) spawn(); place(); return; }
    const progress=1-hp/total, fallMs=BOSS.FALL_MS_START-(BOSS.FALL_MS_START-BOSS.FALL_MS_END)*progress;
    cur.y += dt/(cur.fast?380:fallMs);
    cur.lane += (cur.target-cur.lane)*Math.min(1,dt/70);
    place();
    if(cur.y>=1) land();
  }
  function setPause(p){ if(!alive) return; paused=p; veil.classList.toggle("on",p); document.getElementById("pauseBtn").textContent=p?"▶ PLAY":"⏸ PAUSE"; }
  function onKey(e){
    const k=e.key.toLowerCase();
    if(k==="arrowleft"||k==="a"){ move(-1); e.preventDefault(); }
    else if(k==="arrowright"||k==="d"){ move(1); e.preventDefault(); }
    else if(k==="arrowdown"||k==="s"||k===" "){ drop(); e.preventDefault(); }
    else if(k==="p"||k==="escape"){ setPause(!paused); }
  }
  function onVis(){ if(document.hidden) setPause(true); }
  function stop(){ gone=true; alive=false; cancelAnimationFrame(raf); document.removeEventListener("keydown",onKey); document.removeEventListener("visibilitychange",onVis); }
  function end(win){
    alive=false; setTimeout(()=>{ if(gone) return; stop(); stopCurrent=null;
      const stars = !win ? 0 : misses===0 ? 3 : misses<=maxMiss/2 ? 2 : 1;
      result(5,{stars, missed, title: win?"You beat the Word Dragon! 🏆":"Game over! 👻",
        detail: win ? `Dragon defeated with ${misses} ${misses===1?"miss":"misses"} (limit ${maxMiss})` : `You sorted ${total-hp} of ${total} words before running out of hearts`});
    }, win?1300:1400);
  }

  document.addEventListener("keydown",onKey);
  document.addEventListener("visibilitychange",onVis);
  stopCurrent=stop;
  document.getElementById("lb").onclick=()=>move(-1);
  document.getElementById("rb").onclick=()=>move(1);
  document.getElementById("db").onclick=drop;
  document.getElementById("pauseBtn").onclick=()=>setPause(!paused);
  veil.onclick=()=>setPause(false);
  buckets.forEach(b=>b.onclick=()=>throwTo(+b.dataset.lane));
  hud(); waitUntil=performance.now()+600;
  arena.scrollIntoView({block:"center",behavior:"smooth"});
  raf=requestAnimationFrame(loop);
}

