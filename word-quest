/* ===== Helpers ===== */
const $app = document.getElementById("app");
const $home = document.getElementById("homeBtn");
const shuffle = a => { a=[...a]; for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; };
const esc = s => String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const norm = s => s.toLowerCase().replace(/[’‘]/g,"'").replace(/[().!?,'"]/g,"").replace(/-/g," ").replace(/^a\s+/,"").replace(/\s+/g," ").trim();
function chunks(arr,size){ const n=Math.ceil(arr.length/size), out=[]; let i=0; for(let r=0;r<n;r++){ const len=Math.floor((arr.length-i)/(n-r)); out.push(arr.slice(i,i+len)); i+=len; } return out; }

function say(text){
  try{
    if(!("speechSynthesis" in window)) return;
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text.replace(/[()]/g,"").replace(/\.\.\./g," "));
    u.lang="en-GB"; u.rate=0.85; speechSynthesis.speak(u);
  }catch(e){}
}
let actx=null;
function tone(freqs,type,vol,step=0.11,len=0.16){
  try{
    actx = actx || new (window.AudioContext||window.webkitAudioContext)();
    freqs.forEach((f,i)=>{
      const o=actx.createOscillator(), g=actx.createGain(), t=actx.currentTime+i*step;
      o.type=type; o.frequency.value=f;
      g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(vol,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+len);
      o.connect(g).connect(actx.destination); o.start(t); o.stop(t+len+0.02);
    });
  }catch(e){}
}
const beep = good => good ? tone([660,880],"triangle",0.18) : tone([220,180],"sawtooth",0.08);
function confetti(){
  const box=document.createElement("div"); box.className="confetti";
  const bits=["🎉","⭐","✨","🎊","🌟"];
  for(let i=0;i<28;i++){const b=document.createElement("b"); b.textContent=bits[i%bits.length];
    b.style.left=Math.random()*100+"vw"; b.style.animationDelay=(Math.random()*0.6)+"s"; box.appendChild(b);}
  document.body.appendChild(box); setTimeout(()=>box.remove(),2600);
}
function anim(el,cls){ if(!el) return; el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); }

const BEST_KEY="wordquest-5ci-best";
function loadBest(){ try{ return JSON.parse(localStorage.getItem(BEST_KEY))||{}; }catch(e){ return {}; } }
function saveBest(level,stars){ try{ const b=loadBest(); if(!b[level]||stars>b[level]){ b[level]=stars; localStorage.setItem(BEST_KEY,JSON.stringify(b)); } }catch(e){} }
const starStr = n => "⭐".repeat(n)+"☆".repeat(3-n);

let timer=null, stopCurrent=null;
function later(fn,ms){ clearTimeout(timer); timer=setTimeout(fn,ms); }
function leave(){ clearTimeout(timer); if(stopCurrent){ const s=stopCurrent; stopCurrent=null; s(); } }
const PROG_KEY="wordquest-5ci-progress";   // best (lowest) mistake rate per level
function loadProg(){ try{ return JSON.parse(localStorage.getItem(PROG_KEY))||{}; }catch(e){ return {}; } }
function saveProg(level,rate){ try{ const p=loadProg(); if(p[level]===undefined||rate<p[level]){ p[level]=rate; localStorage.setItem(PROG_KEY,JSON.stringify(p)); } }catch(e){} }
const passed = (p,l) => p[l]!==undefined && p[l]<=UNLOCK.MAX_MISTAKE_RATE + 1e-9;
const bossUnlocked = () => { const p=loadProg(); return [1,2,3,4].every(l=>passed(p,l)); };
const pctStr = r => Math.round(r*100)+"%";
const startLevel = n => (n===5 && !bossUnlocked()) ? locked() : [null,level1,level2,level3,level4,level5,level6][n]();

