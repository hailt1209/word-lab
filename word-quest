/* ===== Level 1: Picture Match (all picture words, 5 per round) ===== */
function level1(){
  leave(); $home.hidden=false;
  const rounds=chunks(shuffle(PIC_WORDS),5), total=PIC_WORDS.length;
  const st={round:0, matched:0, mistakes:0, missed:new Set(), done:new Set(), selPic:null, selWord:null, pics:[], words:[]};
  function startRound(){ const set=rounds[st.round]; st.pics=shuffle(set); st.words=shuffle(set); st.done=new Set(); st.selPic=st.selWord=null; draw(); }
  function draw(){
    $app.innerHTML=`
      <div class="bar"><span class="pill">Round ${st.round+1}/${rounds.length}</span><div class="progress"><i style="width:${st.matched/total*100}%"></i></div><span class="pill">❌ ${st.mistakes}</span></div>
      <p class="prompt">Tap a picture, then tap the word that matches it.</p>
      <div class="match">
        <div class="col">${st.pics.map(o=>`<button class="tile pic ${st.done.has(o.id)?"done":""} ${st.selPic===o.id?"sel":""}" data-pic="${o.id}">${o.p}</button>`).join("")}</div>
        <div class="col">${st.words.map(o=>`<button class="tile word ${st.done.has(o.id)?"done":""} ${st.selWord===o.id?"sel":""}" data-word="${o.id}">${esc(o.w)}</button>`).join("")}</div>
      </div>`;
    $app.querySelectorAll("[data-pic]").forEach(b=>b.onclick=()=>pick("pic",+b.dataset.pic));
    $app.querySelectorAll("[data-word]").forEach(b=>b.onclick=()=>pick("word",+b.dataset.word));
  }
  function pick(kind,id){
    if(st.done.has(id)) return;
    if(kind==="pic") st.selPic = st.selPic===id?null:id; else { st.selWord = st.selWord===id?null:id; if(st.selWord!==null) say(WORDS[id].w); }
    if(st.selPic!==null && st.selWord!==null){
      const p=st.selPic, w=st.selWord; st.selPic=st.selWord=null;
      if(p===w){
        st.done.add(p); st.matched++; beep(true); draw();
        if(st.done.size===rounds[st.round].length){ st.round++; later(()=> st.round<rounds.length ? startRound() : finish(), 700); }
      }else{
        st.mistakes++; st.missed.add(p); beep(false); draw();
        const a=$app.querySelector(`[data-pic="${p}"]`), b=$app.querySelector(`[data-word="${w}"]`);
        [a,b].forEach(el=>{el.classList.add("wrong"); anim(el,"shake");});
        later(()=>[a,b].forEach(el=>el&&el.classList.remove("wrong")),500);
      }
    }else draw();
  }
  function finish(){
    const got=Math.max(0,total-st.mistakes), pct=got/total;
    result(1,{pct, mistakeRate:st.mistakes/total, missed:[...st.missed].map(i=>WORDS[i]), detail:`All ${total} words matched · ${st.mistakes} wrong ${st.mistakes===1?"try":"tries"}`});
  }
  startRound();
}

/* ===== Level 2: Sort it Out (all words) ===== */
function level2(){
  leave(); $home.hidden=false;
  const qs=shuffle(WORDS), N=qs.length, st={i:0, score:0, missed:[]};
  function draw(){
    const q=qs[st.i];
    $app.innerHTML= bar(st.i+1,N,`✅ ${st.score}`) + `
      <p class="prompt">Which topic does this belong to?</p>
      <div class="card pop"><button class="say" id="say" title="Listen">🔊</button><div class="big">${esc(q.w)}</div></div>
      <div class="cats">${Object.entries(CATS).map(([k,c])=>`
        <button class="cat" data-c="${k}" style="--cc:${c.color}"><span class="ic">${c.icon}</span><span>${esc(c.name)}<small>${esc(c.unit)}</small></span></button>`).join("")}</div>
      <div class="feedback" id="fb"></div>`;
    document.getElementById("say").onclick=()=>say(q.w);
    $app.querySelectorAll(".cat").forEach(b=>b.onclick=()=>answer(b,q));
  }
  function answer(btn,q){
    $app.querySelectorAll(".cat").forEach(b=>b.disabled=true);
    const fb=document.getElementById("fb");
    if(btn.dataset.c===q.c){
      btn.classList.add("right"); st.score++; beep(true); fb.className="feedback good"; fb.textContent="Great job! 🎉"; say(q.w); later(next,900);
    }else{
      btn.classList.add("wrong"); anim(btn,"shake"); $app.querySelector(`.cat[data-c="${q.c}"]`).classList.add("right");
      st.missed.push(q); beep(false); fb.className="feedback bad"; fb.textContent=`Oops! It goes in “${CATS[q.c].name}”.`; later(next,1900);
    }
    document.getElementById("scorePill").textContent=`✅ ${st.score}`;
  }
  function next(){ st.i++; st.i<N ? draw() : result(2,{pct:st.score/N, mistakeRate:(N-st.score)/N, missed:st.missed, detail:`${st.score} of ${N} correct`}); }
  draw();
}

/* ===== Level 3: Spell it! (all picture words) ===== */
function level3(){
  leave(); $home.hidden=false;
  const qs=shuffle(PIC_WORDS), N=qs.length;
  const st={i:0, score:0, wrong:0, missed:[], revealed:1, helped:false, tries:0, locked:false};
  function slotsHTML(q){
    let li=0;
    return [...q.t].map(ch=>{
      if(ch===" ") return `<span class="slot gap"></span>`;
      if(!/[a-z]/i.test(ch)) return `<span class="slot shown">${esc(ch)}</span>`;
      const show = li++ < st.revealed;
      return `<span class="slot ${show?"shown":""}">${show?esc(ch):""}</span>`;
    }).join("");
  }
  function draw(){
    const q=qs[st.i], c=CATS[q.c];
    $app.innerHTML= bar(st.i+1,N,`⭐ ${st.score}`) + `
      <p class="prompt">What is this? Type the word.</p>
      <div class="card pop">
        <div class="picbig">${q.p}</div>
        <span class="hintcat">${c.icon} ${esc(c.name)}</span>
        <div class="slots" id="slots">${slotsHTML(q)}</div>
      </div>
      <form class="typebox" id="f" autocomplete="off">
        <input id="inp" type="text" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="Type here…" aria-label="Your answer">
        <button class="btn" type="submit">Check</button>
      </form>
      <div class="tools">
        <button class="btn ghost" id="hear">🔊 Hear it</button>
        <button class="btn ghost" id="hint">💡 Show a letter</button>
        <button class="btn ghost" id="skip">⏭️ Skip</button>
      </div>
      <div class="feedback" id="fb"></div>`;
    const inp=document.getElementById("inp"); inp.focus();
    document.getElementById("f").onsubmit=e=>{e.preventDefault(); check(q,inp);};
    document.getElementById("hear").onclick=()=>{ if(st.locked) return; st.helped=true; say(q.t); inp.focus(); };
    document.getElementById("hint").onclick=()=>{
      if(st.locked) return;
      const letters=q.t.replace(/[^a-z]/gi,"").length;
      if(st.revealed<letters-1){ st.revealed++; st.helped=true; document.getElementById("slots").innerHTML=slotsHTML(q); }
      inp.focus();
    };
    document.getElementById("skip").onclick=()=>{ if(!st.locked) giveUp(q); };
  }
  function check(q,inp){
    if(st.locked) return;
    const v=norm(inp.value); if(!v) return;
    const fb=document.getElementById("fb");
    if(v===norm(q.t) || v===norm(q.w)){
      st.locked=true; const pts=(!st.helped && st.tries===0)?3:1; st.score+=pts;
      inp.classList.add("right"); st.revealed=99; document.getElementById("slots").innerHTML=slotsHTML(q);
      beep(true); say(q.t); fb.className="feedback good"; fb.textContent = pts===3?"Perfect! +3 ⭐":"Correct! +1 ⭐";
      document.getElementById("scorePill").textContent=`⭐ ${st.score}`;
      later(next,1300);
    }else{
      st.tries++; if(st.tries===1) st.wrong++; beep(false); inp.classList.add("wrong"); anim(inp,"shake"); setTimeout(()=>inp.classList.remove("wrong"),500);
      if(st.tries>=3){ giveUp(q); return; }
      fb.className="feedback bad"; fb.textContent = st.tries===1 ? "Not quite – try again! 💪" : "One more try! Use a hint if you need it.";
      inp.select();
    }
  }
  function giveUp(q){
    if(st.tries===0) st.wrong++;
    st.locked=true; st.missed.push(q); st.revealed=99; document.getElementById("slots").innerHTML=slotsHTML(q);
    const fb=document.getElementById("fb"); fb.className="feedback bad"; fb.textContent=`The answer is “${q.t}”.`;
    say(q.t); later(next,2200);
  }
  function next(){
    st.i++; st.revealed=1; st.helped=false; st.tries=0; st.locked=false;
    st.i<N ? draw() : result(3,{pct:st.score/(N*3), mistakeRate:st.wrong/N, missed:st.missed, detail:`${st.score} of ${N*3} stars`});
  }
  draw();
}

/* ===== Level 4: What does it mean? (all words, 4 choices) ===== */
function level4(){
  leave(); $home.hidden=false;
  const qs=shuffle(WORDS), N=qs.length, st={i:0, score:0, missed:[]};
  function options(o){
    const pool=WORDS.filter(x=>x.id!==o.id && !(x.k && x.k===o.k));
    const same=shuffle(pool.filter(x=>x.c===o.c)).slice(0,2);
    const other=shuffle(pool.filter(x=>!same.includes(x))).slice(0,3-same.length);
    return shuffle([o,...same,...other]);
  }
  function draw(){
    const q=qs[st.i], opts=options(q);
    $app.innerHTML= bar(st.i+1,N,`✅ ${st.score}`) + `
      <p class="prompt">What does this mean? Pick the best answer.</p>
      <div class="card pop"><button class="say" id="say" title="Listen">🔊</button><div class="big">${esc(q.w)}</div></div>
      <div class="cats">${opts.map((o,i)=>`
        <button class="cat" data-id="${o.id}"><span class="ic letter">${"ABCD"[i]}</span><span>${esc(o.d)}</span></button>`).join("")}</div>
      <div class="feedback" id="fb"></div>`;
    document.getElementById("say").onclick=()=>say(q.w);
    $app.querySelectorAll(".cat").forEach(b=>b.onclick=()=>answer(b,q));
  }
  function answer(btn,q){
    $app.querySelectorAll(".cat").forEach(b=>b.disabled=true);
    const fb=document.getElementById("fb");
    if(+btn.dataset.id===q.id){
      btn.classList.add("right"); st.score++; beep(true); fb.className="feedback good"; fb.textContent="Correct! 🎉"; later(next,1000);
    }else{
      btn.classList.add("wrong"); anim(btn,"shake"); $app.querySelector(`.cat[data-id="${q.id}"]`).classList.add("right");
      st.missed.push(q); beep(false); fb.className="feedback bad"; fb.textContent="Not this one – look at the green answer."; later(next,2400);
    }
    document.getElementById("scorePill").textContent=`✅ ${st.score}`;
  }
  function next(){ st.i++; st.i<N ? draw() : result(4,{pct:st.score/N, mistakeRate:(N-st.score)/N, missed:st.missed, detail:`${st.score} of ${N} correct`}); }
  draw();
}

