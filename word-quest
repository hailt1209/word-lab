<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Word Quest – Class 5CI English Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#fff8ec; --ink:#2b2350; --muted:#6f6890; --card:#ffffff;
    --line:#ece3d3; --brand:#6c4cf5; --brand-2:#8f75ff;
    --good:#1fae6b; --good-bg:#e4f8ee; --bad:#e5484d; --bad-bg:#fdeaea;
    --sel:#ffb020; --sel-bg:#fff4dc;
    --c-fest:#ff7a45; --c-brain:#e0569b; --c-opinion:#2f9be0; --c-poem:#9b5de5; --c-story:#22a06b;
    --radius:18px; --shadow:0 3px 0 rgba(43,35,80,.10), 0 8px 24px rgba(43,35,80,.07);
    --pixel:"Press Start 2P",monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:"Baloo 2",system-ui,sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;
    background-image:radial-gradient(circle at 10% 0%,#ffe7c2 0,transparent 35%),radial-gradient(circle at 100% 20%,#e7e0ff 0,transparent 30%);}
  button{font-family:inherit;color:inherit;cursor:pointer;border:none;background:none}
  .wrap{max-width:760px;margin:0 auto;padding:16px 16px 48px}
  header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px}
  .logo span.badge{font-size:26px}
  .home{font-weight:700;font-size:15px;padding:8px 14px;border-radius:999px;background:var(--card);box-shadow:var(--shadow)}
  .home[hidden]{display:none}
  h1{font-size:30px;line-height:1.15;margin:4px 0 4px;font-weight:800}
  .sub{color:var(--muted);margin:0 0 18px;font-size:17px}
  .levels{display:grid;gap:12px}
  .level{display:flex;align-items:center;gap:16px;text-align:left;width:100%;padding:14px 18px;border-radius:var(--radius);
    background:var(--card);box-shadow:var(--shadow);border:2px solid transparent;transition:transform .12s,border-color .12s}
  .level:hover{transform:translateY(-2px);border-color:var(--brand-2)}
  .level .num{flex:none;width:56px;height:56px;border-radius:16px;display:grid;place-items:center;font-size:30px;background:var(--nb)}
  .level .t{font-weight:800;font-size:20px;line-height:1.2}
  .level .d{color:var(--muted);font-size:15px;line-height:1.3}
  .level .stars{margin-left:auto;font-size:18px;white-space:nowrap;letter-spacing:1px}
  .level.boss{background:linear-gradient(120deg,#2a1b5e,#47208a);color:#fff}
  .level.boss .d{color:#d6ccff}
  .study-btn{margin-top:16px;width:100%;padding:12px;border-radius:var(--radius);border:2px dashed #cfc3ee;font-weight:700;font-size:17px;color:var(--brand)}
  .study-btn:hover{background:#f3efff}

  .bar{display:flex;align-items:center;gap:12px;margin:4px 0 14px}
  .progress{flex:1;height:12px;background:#eee6d6;border-radius:999px;overflow:hidden}
  .progress i{display:block;height:100%;background:linear-gradient(90deg,var(--brand),var(--brand-2));border-radius:999px;transition:width .3s}
  .pill{font-weight:700;font-size:15px;background:var(--card);padding:4px 12px;border-radius:999px;box-shadow:var(--shadow);white-space:nowrap}
  .prompt{font-size:18px;color:var(--muted);margin:0 0 12px;font-weight:600}

  /* Level 1 */
  .match{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .col{display:grid;gap:10px;align-content:start}
  .tile{min-height:68px;padding:8px 10px;border-radius:16px;background:var(--card);box-shadow:var(--shadow);border:3px solid transparent;
    display:flex;align-items:center;justify-content:center;text-align:center;transition:transform .1s,border-color .1s,background .1s}
  .tile.pic{font-size:38px;line-height:1}
  .tile.word{font-size:19px;font-weight:700;line-height:1.15}
  .tile:hover:not(.done){transform:translateY(-1px)}
  .tile.sel{border-color:var(--sel);background:var(--sel-bg)}
  .tile.done{background:var(--good-bg);border-color:var(--good);opacity:.65;cursor:default}
  .tile.wrong{border-color:var(--bad);background:var(--bad-bg)}

  /* Level 2 & 4 */
  .card{background:var(--card);border-radius:22px;box-shadow:var(--shadow);padding:26px 18px;text-align:center;margin-bottom:16px;position:relative}
  .card .big{font-size:30px;font-weight:800;line-height:1.2;padding:0 30px}
  .say{position:absolute;top:10px;right:10px;font-size:22px;width:42px;height:42px;border-radius:50%;background:#f3efff}
  .say:hover{background:#e7e0ff}
  .cats{display:grid;gap:10px}
  .cat{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;background:var(--card);box-shadow:var(--shadow);
    text-align:left;font-weight:700;font-size:17px;line-height:1.25;border:3px solid transparent;border-left:8px solid var(--cc,#cfc3ee)}
  .cat .ic{font-size:26px;flex:none}
  .cat .ic.letter{width:32px;height:32px;border-radius:10px;background:#f3efff;color:var(--brand);font-size:18px;display:grid;place-items:center}
  .cat small{display:block;font-weight:600;color:var(--muted);font-size:13px}
  .cat:hover:not(:disabled){transform:translateY(-1px)}
  .cat.right{background:var(--good-bg);border-color:var(--good);border-left-color:var(--good)}
  .cat.wrong{background:var(--bad-bg);border-color:var(--bad);border-left-color:var(--bad)}
  .cat:disabled{cursor:default}

  /* Level 3 */
  .picbig{font-size:84px;line-height:1.1}
  .hintcat{display:inline-block;margin-top:6px;font-size:14px;font-weight:700;color:var(--muted);background:#f6f1e6;border-radius:999px;padding:2px 12px}
  .slots{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 4px;margin:16px 0 4px}
  .slot{width:26px;height:36px;border-bottom:3px solid #cfc6e6;font-size:24px;font-weight:800;display:grid;place-items:end center;padding-bottom:2px;text-transform:lowercase}
  .slot.gap{border:none;width:14px}
  .slot.shown{color:var(--brand);border-color:var(--brand)}
  .typebox{display:flex;gap:10px;margin-bottom:12px}
  .typebox input{flex:1;min-width:0;font:inherit;font-size:22px;font-weight:700;padding:10px 16px;border-radius:14px;border:3px solid var(--line);background:#fff;color:var(--ink);outline:none}
  .typebox input:focus{border-color:var(--brand-2)}
  .typebox input.wrong{border-color:var(--bad);background:var(--bad-bg)}
  .typebox input.right{border-color:var(--good);background:var(--good-bg)}
  .btn{padding:10px 18px;border-radius:14px;font-weight:800;font-size:17px;background:var(--brand);color:#fff;box-shadow:0 3px 0 #4b2fd0}
  .btn:hover{filter:brightness(1.07)}
  .btn:active{transform:translateY(2px);box-shadow:0 1px 0 #4b2fd0}
  .btn.ghost{background:var(--card);color:var(--ink);box-shadow:var(--shadow)}
  .tools{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
  .feedback{min-height:28px;text-align:center;font-weight:700;font-size:18px;margin:10px 0 0}
  .feedback.good{color:var(--good)}.feedback.bad{color:var(--bad)}

  /* Result */
  .result{text-align:center;padding:10px 0}
  .result .bigstars{font-size:54px;letter-spacing:6px;margin:6px 0}
  .result .score{font-size:22px;font-weight:700;color:var(--muted)}
  .review{text-align:left;background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px 18px;margin:18px 0}
  .review h3{margin:0 0 8px;font-size:18px}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{background:#f6f1e6;border-radius:999px;padding:4px 12px;font-weight:700;font-size:16px}
  .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}

  /* Study */
  .group{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px 16px;margin-bottom:14px;border-top:6px solid var(--cc)}
  .group h3{margin:0 0 2px;font-size:19px}
  .group .u{color:var(--muted);font-size:14px;font-weight:600;margin-bottom:8px}
  .words{display:grid;gap:6px}
  .w{display:flex;align-items:baseline;gap:8px;background:#faf6ee;border-radius:12px;padding:6px 10px;text-align:left;font-size:15px;color:var(--muted)}
  .w:hover{background:#f0eaff}
  .w b{color:var(--ink);font-size:16px;white-space:nowrap}
  .w .e{font-size:18px}

  /* Level 5 – boss battle */
  .intro{background:linear-gradient(160deg,#1d1446,#3b1f7a);color:#fff;border-radius:22px;padding:22px;text-align:center}
  .intro h1{font-family:var(--pixel);font-size:20px;line-height:1.5;margin:6px 0 12px}
  .intro .hero-row{font-size:56px;margin:4px 0 10px}
  .intro ul{text-align:left;max-width:480px;margin:0 auto 14px;padding-left:20px;font-size:16px;line-height:1.5;color:#e6e0ff}
  .intro select{font:inherit;font-weight:700;padding:4px 8px;border-radius:10px;border:none}
  .intro .btn{font-family:var(--pixel);font-size:14px;padding:14px 22px;background:#ffcc33;color:#2b2350;box-shadow:0 4px 0 #c79400}
  .hud{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;font-family:var(--pixel);font-size:11px}
  .hud .hearts{font-family:inherit;font-size:16px;letter-spacing:1px}
  .hud button{font-family:var(--pixel);font-size:11px;padding:8px 10px;background:var(--card);border-radius:10px;box-shadow:var(--shadow)}
  .arena{position:relative;height:clamp(440px,68vh,620px);border-radius:20px;overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:manipulation;
    background:linear-gradient(#120b33 0%,#2b1866 55%,#4a2a8a 100%);box-shadow:inset 0 0 0 4px #0b0622,var(--shadow)}
  .arena::before{content:"";position:absolute;inset:0;background-image:radial-gradient(2px 2px at 12% 18%,#fff8 50%,transparent 51%),radial-gradient(2px 2px at 70% 10%,#fff8 50%,transparent 51%),radial-gradient(1.5px 1.5px at 40% 30%,#fff6 50%,transparent 51%),radial-gradient(2px 2px at 88% 36%,#fff7 50%,transparent 51%),radial-gradient(1.5px 1.5px at 22% 45%,#fff5 50%,transparent 51%);pointer-events:none}
  .boss{position:absolute;top:8px;left:50%;transform:translateX(-50%);text-align:center;width:70%}
  .boss .face{font-size:64px;line-height:1;display:inline-block;filter:drop-shadow(0 4px 0 #0006)}
  .boss .face.hit{animation:hit .35s}
  @keyframes hit{0%,100%{transform:translateX(0);filter:none}30%{transform:translateX(-8px);filter:brightness(2) saturate(3) hue-rotate(-30deg)}60%{transform:translateX(8px)}}
  .boss .face.dead{animation:die 1s forwards}
  @keyframes die{to{transform:scale(1.6) rotate(25deg);opacity:0}}
  .hpbar{height:12px;background:#0007;border:2px solid #fff;border-radius:4px;overflow:hidden;margin-top:4px}
  .hpbar i{display:block;height:100%;background:linear-gradient(90deg,#ff3d5a,#ff9a3d);transition:width .3s}
  .bossname{font-family:var(--pixel);font-size:10px;color:#ffd6e0;margin-top:5px}
  .fword{position:absolute;top:0;left:0;max-width:46%;background:#fffdf5;color:var(--ink);border-radius:12px;padding:6px 10px;text-align:center;
    font-weight:800;font-size:17px;line-height:1.15;box-shadow:0 4px 0 #0005, 0 0 0 3px #ffcc33;will-change:transform}
  .fword .e{display:block;font-size:22px}
  .fword[hidden]{display:none}
  .heroman{position:absolute;left:0;font-size:46px;line-height:1;will-change:transform;filter:drop-shadow(0 3px 0 #0006)}
  .heroman.hurt{animation:hurt .5s}
  @keyframes hurt{25%{filter:brightness(2) sepia(1) saturate(5) hue-rotate(-40deg)}50%{transform:translateY(-6px)}}
  .heroman.dead{opacity:.5;filter:grayscale(1)}
  .buckets{position:absolute;left:0;right:0;bottom:0;height:82px;display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:0 4px 4px}
  .bucket{border-radius:6px 6px 16px 16px;background:var(--cc);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;
    font-weight:800;font-size:13px;line-height:1.1;box-shadow:inset 0 -6px 0 #0003,inset 0 3px 0 #fff4;border:3px solid #0b0622;text-align:center;padding:2px}
  .bucket .bi{font-size:24px}
  .bucket.good{animation:bgood .5s}
  .bucket.bad{animation:bbad .6s}
  .bucket.hint{outline:4px dashed #fff;outline-offset:-6px}
  @keyframes bgood{50%{transform:scale(1.08);filter:brightness(1.4)}}
  @keyframes bbad{20%,60%{transform:translateX(-5px);background:#e5484d}40%,80%{transform:translateX(5px);background:#e5484d}}
  .toast{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);background:#000c;color:#fff;font-weight:700;font-size:16px;padding:8px 14px;border-radius:12px;text-align:center;max-width:85%;opacity:0;transition:opacity .2s;pointer-events:none}
  .toast.show{opacity:1}
  .bolt{position:absolute;font-size:30px;pointer-events:none}
  .pauseveil{position:absolute;inset:0;background:#0009;display:none;place-items:center;font-family:var(--pixel);color:#fff;font-size:16px;text-align:center;line-height:2}
  .pauseveil.on{display:grid}
  .pad{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px}
  .pad button{font-size:26px;padding:12px 0;border-radius:16px;background:var(--card);box-shadow:0 4px 0 #cfc3ee}
  .pad button:active{transform:translateY(3px);box-shadow:0 1px 0 #cfc3ee}
  .keys-hint{text-align:center;color:var(--muted);font-size:14px;margin-top:8px}

  /* Level 6 – Word Runner */
  .phud{background:var(--card);border-radius:18px;box-shadow:var(--shadow);padding:10px 12px;margin-bottom:10px}
  .pstats{display:flex;align-items:center;gap:10px;font-weight:700;font-size:15px}
  .pstats .hearts{font-size:16px;letter-spacing:1px;margin-right:auto}
  .pstats button{font-size:16px;width:36px;height:32px;border-radius:10px;background:#f3efff}
  .desc{position:relative;text-align:center;padding:6px 44px}
  .desc small{display:block;color:var(--muted);font-weight:700;font-size:13px}
  .desc div{font-size:20px;font-weight:800;line-height:1.25}
  .desc .say{top:4px;right:0}
  .tbar{height:8px;background:#eee6d6;border-radius:999px;overflow:hidden;margin-top:6px}
  .tbar i{display:block;height:100%;width:100%;background:var(--good)}
  .tbar i.low{background:var(--bad)}
  .stage{position:relative;border-radius:16px;overflow:hidden;box-shadow:inset 0 0 0 4px #0b0622,var(--shadow);background:#5ec8ff}
  .stage canvas{display:block;width:100%;aspect-ratio:16/9}
  .pad.run{grid-template-columns:1fr 1fr 1.4fr}
  .pad button{touch-action:none;user-select:none;-webkit-user-select:none}
  .pad .jumpbtn{font-family:var(--pixel);font-size:14px;background:#ffcc33;box-shadow:0 4px 0 #c79400}
  .shake{animation:shake .35s}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
  .pop{animation:pop .3s}
  @keyframes pop{50%{transform:scale(1.04)}}
  .confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:9}
  .confetti b{position:absolute;top:-30px;font-size:26px;animation:fall 1.8s ease-in forwards}
  @keyframes fall{to{transform:translateY(110vh) rotate(540deg);opacity:.8}}
  @media (max-width:480px){
    h1{font-size:26px}.tile.pic{font-size:32px}.tile.word{font-size:16px}.tile{min-height:60px}
    .picbig{font-size:70px}.slot{width:22px;font-size:21px}
    .bucket{font-size:11px}.bucket .bi{font-size:20px}.fword{font-size:15px;max-width:60%}
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="logo"><span class="badge">🦉</span> Word Quest</div>
    <button class="home" id="homeBtn" hidden>🏠 Menu</button>
  </header>
  <main id="app"></main>
</div>

<script>
/* ===== Settings you can change ===== */
const BOSS = {
  MISS_RATE: 0.10,       // Level 5: you lose when misses reach this share of all words (0.10 = 10%)
  FALL_MS_START: 9000,   // time for a word to fall at the start (ms)
  FALL_MS_END: 4500      // time for a word to fall when the boss is almost dead (ms)
};

const RUNNER = {
  TIME_PER_WORD: 40,     // Level 6: seconds to find each word
  LIVES: 5               // Level 6: hearts at the start
};
const UNLOCK = {
  MAX_MISTAKE_RATE: 0.20 // Level 5 opens when Levels 1–4 are each finished with at most this share of mistakes (0.20 = 20%)
};

/* ===== Data: Term 1 review sheet (Global English, class 5CI) ===== */
const CATS = {
  fest:    {name:"Celebrations & festivals", short:"Festivals", unit:"Unit 4 · Special occasions", icon:"🎉", color:"var(--c-fest)"},
  brain:   {name:"Facts about our brain",    short:"Brain",     unit:"Unit 5 · Our brains",        icon:"🧠", color:"var(--c-brain)"},
  opinion: {name:"Phrases to give opinions", short:"Opinions",  unit:"Unit 5 · Our brains",        icon:"💬", color:"var(--c-opinion)"},
  poem:    {name:"Poem: The girl who thought in pictures", short:"Poem", unit:"Unit 5 · Our brains", icon:"📝", color:"var(--c-poem)"},
  story:   {name:"Different types of stories", short:"Stories", unit:"Unit 6 · Great stories",     icon:"📚", color:"var(--c-story)"}
};
// w = word as printed · c = topic · p = picture (only where a clear one exists) · d = meaning
// t = what to type in level 3 (default: word without "a") · k = words that mean nearly the same (never used as each other's wrong answers)
const WORDS = [
  // Unit 4
  {w:"fireworks",c:"fest",p:"🎆",d:"Colourful explosions of light in the night sky at a celebration."},
  {w:"costumes",c:"fest",p:"🧛🦸",d:"Special clothes you wear to dress up as someone or something."},
  {w:"a feast",c:"fest",p:"🍗🍲🍰",d:"A very big, special meal with lots of food."},
  {w:"decorations",c:"fest",p:"🎊🎈",d:"Pretty things you put up to make a place look nice for a party."},
  {w:"lanterns",c:"fest",p:"🏮",d:"Lights inside a paper or glass case that you can hang or carry."},
  {w:"lights",c:"fest",p:"✨💡",d:"Things that shine and make a place bright."},
  {w:"a gift",c:"fest",p:"🎁",d:"Something you give to someone; a present."},
  {w:"paint",c:"fest",p:"🎨🖌️",d:"A coloured liquid you put on things with a brush."},
  {w:"parades",c:"fest",p:"🥁🎺",d:"Lines of people marching, dancing or playing music through the streets."},
  {w:"symbols",c:"fest",p:"☮️☯️❤️",d:"Signs or pictures that stand for an idea."},
  {w:"candle",c:"fest",p:"🕯️",d:"A stick of wax with a string in the middle that burns to give light."},
  {w:"kimono",c:"fest",p:"👘",d:"A long traditional Japanese robe with wide sleeves."},
  {w:"ball dress",c:"fest",p:"👗",d:"A long, beautiful dress for a fancy dance party."},
  {w:"a blessing",c:"fest",p:"🙏",d:"Good wishes or a prayer asking for good things for someone."},
  {w:"Chinese lunar calendar",c:"fest",p:"🌕📅",d:"A calendar that follows the moon; it sets the date of Lunar New Year."},
  {w:"harvest",c:"fest",p:"🌾🧺",d:"The time when farmers collect the crops from their fields."},
  {w:"boiled",c:"fest",p:"♨️🥚",d:"Cooked in very hot, bubbling water."},
  {w:"soft",c:"fest",p:"☁️🧸",d:"Not hard; easy to press, like a pillow."},
  {w:"chewy",c:"fest",p:"🍡",d:"Needs a lot of biting before you can swallow it."},
  {w:"sweet",c:"fest",p:"🍭",d:"Tasting of sugar, like candy."},
  {w:"clever",c:"fest",p:"🤓",d:"Quick to learn and understand things; smart."},
  {w:"moody",c:"fest",p:"😒",d:"Often grumpy, with feelings that change quickly."},
  {w:"jolly",c:"fest",p:"😄",d:"Happy and cheerful."},
  {w:"tough",c:"fest",p:"💪",d:"Strong and not easily hurt or broken."},
  {w:"lazy",c:"fest",p:"🦥",d:"Not wanting to work or do anything."},
  {w:"anxious",c:"fest",p:"😰",d:"Worried or nervous about something."},
  {w:"weepy",c:"fest",p:"😢",d:"Crying easily, or about to cry."},
  {w:"rude",c:"fest",p:"😝",d:"Not polite; saying or doing unkind things."},
  {w:"miserable",c:"fest",p:"😞",d:"Very, very unhappy."},
  {w:"stupid",c:"fest",p:"🤪",d:"Not clever; silly (an unkind word to call a person)."},
  {w:"dry-eyed",c:"fest",d:"Not crying, even when something is sad."},
  // Unit 5 – brain
  {w:"wrinkly",c:"brain",p:"👵",d:"Covered in lots of folds and lines."},
  {w:"organ",c:"brain",p:"🫀",d:"A body part with a special job, like the heart or the brain."},
  {w:"speech",c:"brain",p:"🗣️",d:"The ability to talk and say words."},
  {w:"emotions",c:"brain",p:"😊😢😡",d:"Feelings such as happy, sad or angry."},
  {w:"accurate",c:"brain",p:"🎯",d:"Exactly right, with no mistakes."},
  {w:"brain stem",c:"brain",d:"The part that joins the brain to the spinal cord and controls breathing and heartbeat."},
  {w:"cerebrum",c:"brain",d:"The biggest part of the brain, used for thinking, memory and the senses."},
